      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Winner: most matches; level → the complete team; then most games, most rally points, winner of E1. League points: games + 3 bonus for the winner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Winnaar: meeste partijen; gelijk → het volledige team; dan meeste games, meeste rallypunten, winnaar E1. Competitiepunten: games + 3 bonus voor de winnaar."
          }
        }
      }
    },
