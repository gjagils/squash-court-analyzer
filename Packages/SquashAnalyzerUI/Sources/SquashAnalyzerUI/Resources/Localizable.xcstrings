    "Eén keer per week, als je de app na gebruik wegzet, komt er een back-up in een map die je kiest (bijvoorbeeld Documenten). De 7 nieuwste blijven bewaard.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a week, when you put the app away after use, a backup is saved in a folder you choose (for example Documents). The 7 most recent are kept."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer per week, als je de app na gebruik wegzet, komt er een back-up in een map die je kiest (bijvoorbeeld Documenten). De 7 nieuwste blijven bewaard."
          }
        }
      }
    },
