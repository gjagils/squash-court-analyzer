<?xml version="1.0" encoding="utf-8"?>
<!-- Team match notification (Android 9-15), design B (20 October 2026): the
     partij at the top, added to team_top in code. A heading ("● E3 · bezig"
     red, "E3 · pauze" grey) with the games of the partij on the right, then
     the home player (avatar, name), the points large in the middle ("pauze"
     between games, "–" before the start) and the away player. The gold dot
     on the avatar of whoever serves. Without a partij yet: "spelers nog niet
     bekend". Variants are separate views of which code shows one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/focus_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/live_dot" />

        <TextView
            android:id="@+id/focus_heading_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/live_live"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/focus_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/live_text2"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/focus_games"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/live_text2"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/focus_players"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|start"
                android:background="@drawable/live_avatar_ring1"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/focus_photo1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/focus_initial1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:textColor="@color/live_p1"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView
                android:id="@+id/focus_serve1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|end"
                android:contentDescription="serveert"
                android:src="@drawable/team_serve_dot"
                android:visibility="invisible" />
        </FrameLayout>

        <TextView
            android:id="@+id/focus_name1"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="15sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/live_p1"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/focus_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/live_live"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/focus_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/live_text2"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/focus_name2"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="15sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:textColor="@color/live_p2"
            android:textSize="15sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:background="@drawable/live_avatar_ring2"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/focus_photo2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/focus_initial2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:textColor="@color/live_p2"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView
                android:id="@+id/focus_serve2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|start"
                android:contentDescription="serveert"
                android:src="@drawable/team_serve_dot"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/focus_unknown"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:maxLines="1"
        android:text="spelers nog niet bekend"
        android:textColor="@color/live_dim"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
