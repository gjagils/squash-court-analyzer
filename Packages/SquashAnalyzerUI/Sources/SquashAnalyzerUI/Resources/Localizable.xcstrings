    "Als dank voor het testen krijgen je spelers de badge Pionier. Je vindt hem bij je spelers en in de lijst onder Speciaal.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As thanks for testing, your players get the Pioneer badge. You'll find it with your players and in the list under Special."
          }
        },
        "nl": {
