<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded live score notification before Android 16: a mini scoreboard.
     Player colours are set in code (LiveScoreNotifier); the rest follows the
     notification's own light or dark text colours. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/live_serve1"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#FF9926"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/live_name1"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_pips1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:letterSpacing="0.15"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/live_score1"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/live_serve2"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#FF9926"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/live_name2"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_pips2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:letterSpacing="0.15"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/live_score2"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/live_footer_games"
            style="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/live_footer_status"
            style="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
