<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed live score notification before Android 16: "Gerd-Jan [1] 9 – 7 [0] Thomas"
     with the games won in boxes, and the status line below (see
     notification_live_score.xml for the expanded ticker) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/live_name1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/live_p1"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_games1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/live_games_box1"
            android:gravity="center"
            android:minWidth="22dp"
            android:paddingLeft="5dp"
            android:paddingTop="1dp"
            android:paddingRight="5dp"
            android:paddingBottom="1dp"
            android:textColor="@color/live_text2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_score"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_games2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/live_games_box2"
            android:gravity="center"
            android:minWidth="22dp"
            android:paddingLeft="5dp"
            android:paddingTop="1dp"
            android:paddingRight="5dp"
            android:paddingBottom="1dp"
            android:textColor="@color/live_text2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/live_name2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/live_p2"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/live_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="@color/live_p1"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
