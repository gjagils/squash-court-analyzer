<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.squashanalyzer.app.card</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>squashanalyzer</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Live meekijken: lets a local test server (http://<ip>:8080) work; the internet still needs HTTPS -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The app is dark throughout: system alerts, menus and sheets follow (white alert in a light-mode test, 7 October) -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
