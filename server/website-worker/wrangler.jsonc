// Squash Analyzer — the static website (website/) on Cloudflare as a Worker
// with static assets (the current form of Cloudflare Pages), on
// squashanalyzer.com and www (custom domains; the NAS copy behind the tunnel
// is the reserve). website/_headers sets the JSON types for the deep-link
// files and keeps /teams/ out of search engines. website/screenshots/ and
// website/teams/ are outside git, so deploy from the Mac, not from CI.
// Deploy: npx wrangler deploy -c server/website-worker/wrangler.jsonc
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "squashanalyzer-site",
  "compatibility_date": "2026-10-01",
  // Only squashanalyzer.com and www: no second hostname for the same pages
  // (and the team zips) on workers.dev
  "workers_dev": false,
  "routes": [
    { "pattern": "squashanalyzer.com", "custom_domain": true },
    { "pattern": "www.squashanalyzer.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../../website",
    "html_handling": "auto-trailing-slash",
    // website/404.html
    "not_found_handling": "404-page"
  }
}
