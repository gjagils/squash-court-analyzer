<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded team match notification before Android 16, as the iOS lock
     screen (design "variant 3b", 18 October 2026): E1-E4 as rows
     (notification_team_row.xml, added in code), then a bar with the mark, the
     teams with their games in boxes and LIVE. Same colours as the single match
     (live_colors.xml, light and night). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/team_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="6dp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/live_p1_line"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/live_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="8dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="SquashAnalyzer"
            android:src="@drawable/live_mark" />

        <TextView
            android:id="@+id/team_home_name"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeTextType="uniform"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/live_p1"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/team_home_games"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/live_games_box1"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="30dp"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="–"
            android:textColor="@color/live_text2"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/team_away_games"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/live_games_box2"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="30dp"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/team_away_name"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeTextType="uniform"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:textColor="@color/live_p2"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/team_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/live_pill"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:paddingLeft="7dp"
            android:paddingTop="1dp"
            android:paddingRight="7dp"
            android:paddingBottom="1dp"
            android:text="● LIVE"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
