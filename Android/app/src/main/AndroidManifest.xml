<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Mijn team: the public team pages on sbn.toernooi.nl -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Live score on the lock screen: the notification (asked when following
         a match) and, on Android 16+, its promotion to a Live Update -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:name=".SquashApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.SquashAnalyzer">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Player card links, the same ones iOS shares. Verified through
                 website/.well-known/assetlinks.json (Play signing key and upload
                 key); a debug build is signed differently and gets "open with". -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="squashanalyzer.com" />
                <data android:host="www.squashanalyzer.com" />
                <!-- Exact paths: /kaartjes or /teams/<code>/team.zip must stay
                     in the browser (the team zip is a download) -->
                <data android:path="/kaart" />
                <data android:pathPrefix="/kaart/" />
                <data android:path="/team" />
                <data android:pathPrefix="/team/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="squashanalyzer" android:host="kaart" />
                <data android:scheme="squashanalyzer" android:host="team" />
                <!-- Live score on the lock screen: squashanalyzer://volg#<id>[@<host>] -->
                <data android:scheme="squashanalyzer" android:host="volg" />
            </intent-filter>
        </activity>
        <!-- Live score pushes (FCM data messages from the live server) -->
        <service
            android:name=".live.LiveFollowMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- "Stoppen" on the live score notification, and swiping it away -->
        <receiver
            android:name=".live.LiveFollowActionReceiver"
            android:exported="false" />
        <!-- Firebase is started by FirebaseConfig with values from the build
             (no google-services.json in the repo), not by its own provider;
             no token until a match is followed, no analytics -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
        <!-- Shares the badge card picture ("Deel kaart") with other apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Instellingen → Taal before Android 13: AppCompat keeps the app's locale itself -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
