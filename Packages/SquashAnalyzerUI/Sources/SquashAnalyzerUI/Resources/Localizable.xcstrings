    "Bij 6 vakken kies je voor, midden of achter, links of rechts; bij 9 komt er een middenkolom bij. De slagen die je ziet passen bij de rij van het vak.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With 6 zones you choose front, middle or back, left or right; with 9 a middle column is added. The shots you see match the row of the zone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij 6 vakken kies je voor, midden of achter, links of rechts; bij 9 komt er een middenkolom bij. De slagen die je ziet passen bij de rij van het vak."
          }
        }
      }
    },
    "Bij een gevolgde wedstrijd: een melding met geluid als er een game is uitgespeeld en bij de uitslag. Bij een teamwedstrijd: per partij en bij de einduitslag.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a followed match: a notification with sound when a game has finished and for the result. For a team match: per match and for the final result."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij een gevolgde wedstrijd: een melding met geluid als er een game is uitgespeeld en bij de uitslag. Bij een teamwedstrijd: per partij en bij de einduitslag."
          }
        }
      }
    },
