    "Deel deze teamwedstrijd met je team: teamgenoten zetten hun eigen partij erop en supporters volgen de stand van de hele avond, per partij ook punt voor punt. Alleen teamnamen, voornamen en de stand gaan mee.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share this team match with your team: teammates add their own match and supporters follow the score of the whole evening, per match point by point as well. Only team names, first names and the score are sent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel deze teamwedstrijd met je team: teamgenoten zetten hun eigen partij erop en supporters volgen de stand van de hele avond, per partij ook punt voor punt. Alleen teamnamen, voornamen en de stand gaan mee."
          }
        }
      }
    },
