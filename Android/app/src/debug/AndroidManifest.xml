<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug only: sample live score notifications via adb (see LiveScoreSampleReceiver) -->
        <receiver
            android:name=".live.LiveScoreSampleReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver"
            xmlns:tools="http://schemas.android.com/tools">
            <intent-filter>
                <action android:name="com.squashanalyzer.android.debug.LIVE_SAMPLE" />
            </intent-filter>
        </receiver>
        <!-- Debug only: shows which text fields Android autofill gets to see (see AutofillProbeService) -->
        <service
            android:name=".AutofillProbeService"
            android:exported="true"
            android:label="Autofill probe"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
        </service>
    </application>
</manifest>
