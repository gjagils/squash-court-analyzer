<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Opens CloudKit share links (player cards) in the app -->
	<key>CKSharingSupported</key>
	<true/>
	<!-- Silent CloudKit pushes keep shared player cards up to date -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- squashanalyzer://kaart#… opens a card snapshot (fallback for the web page) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.squashanalyzer.app.card</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>squashanalyzer</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
