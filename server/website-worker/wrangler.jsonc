// Squash Analyzer — the static website (website/) on Cloudflare as a Worker
// with static assets (the current form of Cloudflare Pages), on
// squashanalyzer.com and www (custom domains; the NAS copy behind the tunnel
// is the reserve). website/_headers sets the JSON types for the deep-link
// files and keeps the old /teams/ out of search engines. website/screenshots/
// is outside git, so deploy from the Mac, not from CI.
// Deploy: npx wrangler deploy -c server/website-worker/wrangler.jsonc
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "squashanalyzer-site",
  // Since 10 November 2026 a small script in front: POST /api/vraag answers a
  // question from the manual with Workers AI (src/help.js); everything else is
  // served straight from the static files
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // Only squashanalyzer.com and www: no second hostname for the same pages
  // (and the team zips) on workers.dev
  "workers_dev": false,
  "routes": [
    { "pattern": "squashanalyzer.com", "custom_domain": true },
    { "pattern": "www.squashanalyzer.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../../website",
    "html_handling": "auto-trailing-slash",
    // website/404.html
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // Only the API runs the script first; pages and images stay plain static files
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  // The account database (EU), for the questions of "Stel een vraag" (table
  // manual_questions, migration 0005 in server/account-worker). The STATS_KEY
  // secret (wrangler secret put) guards GET /api/vraag/stats.
  "d1_databases": [
    { "binding": "DB", "database_name": "squash-account", "database_id": "47df8ba1-503e-41b1-810b-aa57affa8a8b" }
  ],
  // At most 10 questions a minute per IP address
  "ratelimits": [
    { "name": "VRAAG_LIMIT", "namespace_id": "1010", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
