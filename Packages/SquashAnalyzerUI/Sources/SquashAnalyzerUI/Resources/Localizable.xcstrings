    "De livepagina is afgelopen (2 uur na de laatste update) en wordt niet meer bijgewerkt.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live page has ended (2 hours after the last update) and is no longer updated."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De livepagina is afgelopen (2 uur na de laatste update) en wordt niet meer bijgewerkt."
          }
        }
      }
    },
    "De livepagina is meteen weg voor iedereen. Je teamwedstrijd blijft in de app staan.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live page disappears for everyone straight away. Your team match stays in the app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De livepagina is meteen weg voor iedereen. Je teamwedstrijd blijft in de app staan."
          }
        }
      }
    },
    "De livepagina lijkt afgelopen. Tik op Vernieuwen om dat te bevestigen.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live page seems to have ended. Tap Refresh to confirm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De livepagina lijkt afgelopen. Tik op Vernieuwen om dat te bevestigen."
          }
        }
      }
    },
    "De livepagina wil je partij niet hebben: de uitnodigingscode klopt niet (meer). Vraag je teamgenoot de uitnodiging opnieuw te sturen en doe weer mee.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live page does not accept your match: the invitation code is not (or no longer) valid. Ask your teammate to send the invitation again and join again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De livepagina wil je partij niet hebben: de uitnodigingscode klopt niet (meer). Vraag je teamgenoot de uitnodiging opnieuw te sturen en doe weer mee."
          }
        }
      }
    },
    "De namen gelden voor deze wedstrijd, ook voor wie live meekijkt. De stand blijft staan.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The names apply to this match, also for anyone watching live. The score stays as it is."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De namen gelden voor deze wedstrijd, ook voor wie live meekijkt. De stand blijft staan."
          }
        }
      }
    },
    "De opgeslagen spelers konden niet worden geladen. Probeer het opnieuw.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved players could not be loaded. Please try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgeslagen spelers konden niet worden geladen. Probeer het opnieuw."
          }
        }
      }
    },
    "De teamwedstrijd blijft alleen op deze telefoon. Je kunt hem later nog delen.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The team match stays on this phone only. You can still share it later."
